{
    "name": "redhn",
    "version": "1.0.0",
    "description": "RedHN: A Reddit-style extension for Hacker News",
    "homepage": "https://github.com/fanjin-z/RedHN#readme",
    "bugs": {
        "url": "https://github.com/fanjin-z/RedHN/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fanjin-z/RedHN.git"
    },
    "license": "MIT",
    "author": "",
    "type": "module",
    "engines": {
        "node": ">=22.13.0 <23"
    },
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "build:safari": "wxt build -b safari --mv3",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "zip:safari": "wxt zip -b safari --mv3",
        "package:safari": "scripts/package-safari.sh",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:all": "prettier --write .",
        "format:cached": "prettier $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g') --write --ignore-unknown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "wxt prepare",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "linkedom": "^0.18.13",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.10",
        "web-ext": "^10.5.0",
        "wxt": "^0.21.3"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
